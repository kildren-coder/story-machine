# 拷成 .sandcastle/.env 再填。填好的文件绝不提交(.sandcastle/.gitignore 已忽略)。
# 与 agent-alert 用的是同一个订阅和同一个 GitHub 账号,直接拷那边的 .env 也行。

# 沙箱内 Claude Code 的登录凭据。生成:claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# 转发进沙箱的 GitHub token,agent 受阻时用它评论 issue。宿主机侧的 gh
# (取票、推分支、开 PR)走本机 `gh auth login`,不需要这个。生成:gh auth token
GH_TOKEN=

# 模型与思考深度(默认见 afk.ts:实现 claude-sonnet-5,评审 claude-opus-4-8,
# 思考深度 high)。实现是执行密集型,sonnet 控成本;评审冷读 diff 判验收,更吃模型。
# AFK_IMPLEMENT_MODEL=claude-sonnet-5
# AFK_REVIEW_MODEL=claude-opus-4-8
# AFK_EFFORT=high

# 容器出网。本机 Clash TUN 通常透明代理容器流量;镜像构建期的连通性检查失败时,
# 取消注释让沙箱显式走 Clash。
# AFK_SANDBOX_PROXY=http://host.docker.internal:7890

# 额度门槛(默认见 quota.ts;与 agent-alert 共用同一把尺,那边标定过的值直接拷)。
# AFK_QUOTA_STOP_PERCENT=90
# AFK_UNITS_PER_PERCENT=60000
# AFK_RATE_LIMITS_FILE=C:/Users/kildren/.claude/rate-limits.json
